# Copier en .env sur le serveur, puis remplir. NE PAS committer le .env réel.
# Générer un secret fort :  openssl rand -hex 32   (ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# Domaine public qui pointe vers l'IP de la VM (ex. un sous-domaine DuckDNS gratuit)
DOMAIN=smartbooking.exemple.duckdns.org
# E-mail pour les certificats Let's Encrypt (notifications d'expiration)
[email protected]

# Mot de passe PostgreSQL (fort)
POSTGRES_PASSWORD=

# Secrets JWT (deux valeurs différentes, 64 caractères hexadécimaux chacune)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
