# ---- SmartBooking API environment ----
# Copy to .env and adjust for your environment.

# Runtime
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://smartbooking:smartbooking@localhost:5432/smartbooking?schema=public"

# JWT secrets — use long random values in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info
